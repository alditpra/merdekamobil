---
import type { Car } from '../utils/types';
import CarCard from './CarCard.astro';

interface Props {
  cars: Car[];
  limit?: number;
}

const { cars, limit = 6 } = Astro.props;

// Get featured cars - prioritize featured flag, then newest available
const featuredCars = cars
  .filter(car => car.status === 'available')
  .sort((a, b) => {
    // Featured cars first
    if (a.featured && !b.featured) return -1;
    if (!a.featured && b.featured) return 1;
    // Then by date added (newest first)
    return new Date(b.date_added || 0).getTime() - new Date(a.date_added || 0).getTime();
  })
  .slice(0, limit);
---

<section id="featured" class="py-16 lg:py-24 bg-neutral-50 dark:bg-neutral-900">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center mb-12 lg:mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-red-200 dark:bg-red-900/50 text-red-800 dark:text-red-300 text-sm font-semibold mb-4">
        🚗 Pilihan Terbaik
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black text-neutral-900 dark:text-white mb-4">
        Stok <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-orange-500">Terbaru</span> Minggu Ini
      </h2>
      <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto px-4 sm:px-0">
        Koleksi mobil bekas berkualitas yang sudah melewati inspeksi ketat dan siap jadi milik Anda
      </p>
    </div>

    <!-- Cars Grid -->
    {featuredCars.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {featuredCars.map((car, index) => (
          <div data-animate data-delay={(index % 6) + 1}>
            <CarCard car={car} />
          </div>
        ))}
      </div>
    ) : (
      <div class="text-center py-12">
        <p class="text-neutral-500 dark:text-neutral-400">Belum ada mobil tersedia saat ini.</p>
      </div>
    )}

    <!-- View All Button -->
    <div class="text-center mt-12">
      <a href="/mobil-tersedia" class="btn text-base sm:text-lg px-6 sm:px-8 py-3 sm:py-4 inline-flex items-center gap-2 group bg-gradient-to-r from-blue-500 to-blue-600 hover:from-blue-600 hover:to-blue-700 text-white font-semibold shadow-lg">
        <span>Lihat Semua Mobil</span>
        <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>
