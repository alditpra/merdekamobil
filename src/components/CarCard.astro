---
import type { Car } from '../utils/types';
import { formatPrice, formatMileage } from '../utils/formatters';
import { getCarPrimaryImage } from '../utils/imageUtils';

export interface Props {
  car: Car;
}

const { car } = Astro.props;
const mainImage = getCarPrimaryImage(car);
---

<div class="car-card group">
  <!-- Image Container -->
  <div class="relative aspect-[4/3] overflow-hidden rounded-t-2xl bg-gradient-to-br from-neutral-100 to-neutral-200 dark:from-neutral-800 dark:to-neutral-900">
    <img
      src={mainImage}
      alt={`${car.brand} ${car.model} ${car.year}`}
      loading="lazy"
      decoding="async"
      width="400"
      height="300"
      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
      onerror="this.src='/placeholder-car.svg'"
    />
    
    <!-- Gradient Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
    
    <!-- Badges -->
    <div class="absolute top-2 sm:top-3 left-2 sm:left-3 flex flex-wrap gap-1.5 sm:gap-2">
      {car.status === 'sold' && (
        <span class="px-2 sm:px-3 py-0.5 sm:py-1 text-[10px] sm:text-xs font-bold rounded-full bg-neutral-800/90 text-white">
          TERJUAL
        </span>
      )}
      {car.featured && car.status === 'available' && (
        <span class="px-2 sm:px-3 py-0.5 sm:py-1 text-[10px] sm:text-xs font-bold rounded-full bg-gradient-to-r from-red-500 to-orange-500 text-white shadow-lg">
          ⭐ PILIHAN
        </span>
      )}
      {car.badge && car.status === 'available' && (
        <span class="px-2 sm:px-3 py-0.5 sm:py-1 text-[10px] sm:text-xs font-bold rounded-full bg-gradient-to-r from-blue-500 to-purple-600 text-white shadow-lg">
          {car.badge}
        </span>
      )}
    </div>

    <!-- Price Tag on Image -->
    <div class="absolute bottom-2 sm:bottom-3 left-2 sm:left-3 right-2 sm:right-3">
      <div class="inline-block px-3 sm:px-4 py-1.5 sm:py-2 rounded-xl bg-white/95 dark:bg-neutral-900/95 backdrop-blur-sm shadow-lg">
        <span class="text-lg sm:text-xl font-black text-green-600 dark:text-green-500">
          {formatPrice(car.price, true)}
        </span>
      </div>
    </div>
  </div>
  
  <!-- Content -->
  <div class="p-4 sm:p-5 space-y-3 sm:space-y-4 bg-white dark:bg-neutral-800 rounded-b-2xl border border-t-0 border-neutral-200 dark:border-neutral-700">
    <!-- Title -->
    <a href={`/mobil/${car.id}`} class="block group/title">
      <h3 class="font-bold text-lg text-neutral-900 dark:text-white line-clamp-1 group-hover/title:text-blue-600 dark:group-hover/title:text-blue-400 transition-colors">
        {car.brand} {car.model}
      </h3>
      <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-0.5">
        {car.year} • {car.color}
      </p>
    </a>
    
    <!-- Specs Grid -->
    <div class="grid grid-cols-3 gap-2">
      <div class="flex flex-col items-center p-2 rounded-lg bg-neutral-50 dark:bg-neutral-700/50">
        <!-- Speedometer/Gauge Icon for Mileage -->
        <svg class="w-4 h-4 text-blue-500 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">{formatMileage(car.mileage)}</span>
      </div>
      <div class="flex flex-col items-center p-2 rounded-lg bg-neutral-50 dark:bg-neutral-700/50">
        <!-- Gear/Cog Icon for Transmission -->
        <svg class="w-4 h-4 text-blue-500 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
        </svg>
        <span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">{car.transmission}</span>
      </div>
      <div class="flex flex-col items-center p-2 rounded-lg bg-neutral-50 dark:bg-neutral-700/50">
        <!-- Fuel Pump Icon -->
        <svg class="w-4 h-4 text-blue-500 mb-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
        </svg>
        <span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">{car.fuel}</span>
      </div>
    </div>
    
    <!-- Action Buttons -->
    <div class="flex gap-2">
      {car.status === 'available' && (
        <a
          href={`https://wa.me/628158141112?text=Halo, saya tertarik dengan ${car.brand} ${car.model} ${car.year} (${formatPrice(car.price)}). Apakah masih tersedia?`}
          target="_blank"
          rel="noopener noreferrer"
          class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-xl bg-green-500 hover:bg-green-600 transition-colors shadow-lg shadow-green-500/25"
          aria-label="WhatsApp"
        >
          <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
        </a>
      )}
      <a
        href={`/mobil/${car.id}`}
        class={car.status === 'available' 
          ? 'flex-1 flex items-center justify-center gap-2 py-3 rounded-xl font-bold text-sm bg-gradient-to-r from-red-500 to-red-600 text-white hover:from-red-600 hover:to-red-700 transition-all shadow-lg shadow-red-500/25 hover:shadow-red-500/40' 
          : 'flex-1 flex items-center justify-center gap-2 py-3 rounded-xl font-bold text-sm bg-neutral-200 dark:bg-neutral-700 text-neutral-500 cursor-not-allowed'}
      >
        {car.status === 'available' ? (
          <>
            <span>Lihat Detail</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </>
        ) : 'Terjual'}
      </a>
    </div>
  </div>
</div>

<style>
  .car-card {
    @apply rounded-2xl overflow-hidden transition-all duration-300 shadow-layered;
  }
  
  .car-card:hover {
    @apply -translate-y-1 shadow-lg-layered;
  }
</style>
