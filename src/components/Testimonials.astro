---
// Testimonials Section - Mixed Media (Screenshots, Photos, Video)
import { fetchTestimonials } from '../utils/fetchData';
import type { Testimonial } from '../utils/types';

// Extract YouTube video ID from various URL formats
function getYouTubeVideoId(input: string): string {
  // Already just an ID (11 characters, no slashes or dots)
  if (/^[a-zA-Z0-9_-]{11}$/.test(input)) {
    return input;
  }
  
  // YouTube Shorts: https://www.youtube.com/shorts/VIDEO_ID or https://youtube.com/shorts/VIDEO_ID
  const shortsMatch = input.match(/(?:youtube\.com\/shorts\/)([a-zA-Z0-9_-]{11})/);
  if (shortsMatch) return shortsMatch[1];
  
  // Standard YouTube: https://www.youtube.com/watch?v=VIDEO_ID
  const watchMatch = input.match(/(?:youtube\.com\/watch\?v=)([a-zA-Z0-9_-]{11})/);
  if (watchMatch) return watchMatch[1];
  
  // Short URL: https://youtu.be/VIDEO_ID
  const shortUrlMatch = input.match(/(?:youtu\.be\/)([a-zA-Z0-9_-]{11})/);
  if (shortUrlMatch) return shortUrlMatch[1];
  
  // Embed URL: https://www.youtube.com/embed/VIDEO_ID
  const embedMatch = input.match(/(?:youtube\.com\/embed\/)([a-zA-Z0-9_-]{11})/);
  if (embedMatch) return embedMatch[1];
  
  // Return as-is if no match (fallback)
  return input;
}

// Fetch testimonials from spreadsheet, fallback to dummy data
let testimonials: Testimonial[] = await fetchTestimonials();

// Fallback dummy data if spreadsheet is empty
if (testimonials.length === 0) {
  testimonials = [
    { id: '1', type: 'screenshot', media: '', name: 'Budi Santoso', car: 'Toyota Avanza 2019', rating: 5 },
    { id: '2', type: 'photo', media: '', name: 'Sari Dewi', car: 'Honda Jazz 2020', quote: 'Pelayanan sangat memuaskan!', rating: 5 },
    { id: '3', type: 'video', media: 'dQw4w9WgXcQ', name: 'Ahmad Rizki', car: 'Daihatsu Xenia 2021', rating: 5 },
  ];
}
---

<section class="py-16 lg:py-24 bg-neutral-50 dark:bg-neutral-900">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center mb-12 lg:mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-accent-100 dark:bg-accent-900/30 text-accent-600 dark:text-accent-400 text-sm font-semibold mb-4">
        💬 Kata Mereka
      </span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-neutral-900 dark:text-white mb-4">
        Testimoni <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-500 to-primary-600">Pelanggan</span>
      </h2>
      <p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">
        Bukti nyata kepuasan pelanggan yang sudah mempercayai Merdeka Mobil
      </p>
    </div>

    <!-- Testimonials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonials.map((item) => (
        <div class="testimonial-card group rounded-2xl overflow-hidden bg-white dark:bg-neutral-800 shadow-lg hover:shadow-xl transition-all duration-300 hover:-translate-y-1">
          
          {/* Screenshot or Photo */}
          {(item.type === 'screenshot' || item.type === 'photo') && (
            <div class="relative aspect-video overflow-hidden bg-neutral-100 dark:bg-neutral-700">
              <!-- Placeholder (Background) -->
              <div class="absolute inset-0 bg-gradient-to-br from-neutral-200 to-neutral-300 dark:from-neutral-600 dark:to-neutral-700 flex items-center justify-center">
                {item.type === 'screenshot' ? (
                  <div class="text-center p-6">
                    <div class="w-16 h-16 mx-auto mb-3 rounded-2xl bg-green-500 flex items-center justify-center">
                      <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                      </svg>
                    </div>
                    <p class="text-neutral-500 dark:text-neutral-400 text-sm font-medium">Screenshot WhatsApp</p>
                    <p class="text-neutral-400 dark:text-neutral-500 text-xs mt-1">{item.name}</p>
                  </div>
                ) : (
                  <div class="text-center p-6">
                    <div class="w-16 h-16 mx-auto mb-3 rounded-full bg-neutral-400 flex items-center justify-center">
                      <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                      </svg>
                    </div>
                    <p class="text-neutral-500 dark:text-neutral-400 text-sm font-medium">Foto Pelanggan</p>
                    <p class="text-neutral-400 dark:text-neutral-500 text-xs mt-1">{item.name}</p>
                  </div>
                )}
              </div>

              <!-- Actual Image (Photo/Screenshot) -->
              {item.media && (item.type === 'screenshot' || item.type === 'photo') && (
                <button 
                  class="absolute inset-0 w-full h-full cursor-zoom-in group-hover:scale-105 transition-transform duration-500 z-10 focus:outline-none"
                  onclick={`openLightbox('${item.type}', '${item.media}')`}
                  aria-label="Perbesar gambar"
                >
                  <img 
                    src={item.media} 
                    alt={item.name}
                    class="w-full h-full object-cover"
                    loading="lazy"
                    onerror="this.parentElement.style.display='none'"
                  />
                  <!-- Hover Overlay -->
                  <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center opacity-0 group-hover:opacity-100">
                    <svg class="w-10 h-10 text-white drop-shadow-lg transform scale-75 group-hover:scale-100 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                    </svg>
                  </div>
                </button>
              )}
              
              <!-- Badge -->
              <div class="absolute top-3 left-3 z-20 pointer-events-none">
                <span class={`px-3 py-1 text-xs font-bold rounded-full shadow-md ${item.type === 'screenshot' ? 'bg-green-500 text-white' : 'bg-blue-500 text-white'}`}>
                  {item.type === 'screenshot' ? '💬 Chat WA' : '📸 Foto'}
                </span>
              </div>
            </div>
          )}

          {item.type === 'video' && (
            <div class="relative aspect-video overflow-hidden bg-neutral-900">
              <!-- Video Placeholder (Background) -->
              <div class="absolute inset-0 bg-gradient-to-br from-red-600 to-red-800 flex items-center justify-center">
                 <div class="text-center">
                    <p class="text-white/80 text-sm">Video</p>
                 </div>
              </div>

              <!-- Video Thumbnail + Click Trigger -->
              {item.media && (
                <button
                  class="absolute inset-0 w-full h-full z-10 group/video cursor-pointer focus:outline-none"
                  onclick={`openLightbox('video', '${getYouTubeVideoId(item.media)}')`}
                  aria-label="Putar video"
                >
                  <img 
                    src={`https://img.youtube.com/vi/${getYouTubeVideoId(item.media)}/hqdefault.jpg`}
                    alt={`Thumbnail ${item.name}`}
                    class="w-full h-full object-cover opacity-80 group-hover/video:opacity-100 transition-opacity"
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />
                  
                  <!-- Play Icon Overlay -->
                  <div class="absolute inset-0 flex items-center justify-center">
                    <div class="w-16 h-16 rounded-full bg-white/20 backdrop-blur-sm border border-white/30 flex items-center justify-center group-hover/video:scale-110 group-hover/video:bg-red-600 group-hover/video:border-red-600 transition-all duration-300 shadow-xl">
                      <svg class="w-8 h-8 text-white ml-1" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z"/>
                      </svg>
                    </div>
                  </div>
                </button>
              )}
              
              <!-- Badge -->
              <div class="absolute top-3 left-3 z-20 pointer-events-none">
                <span class="px-3 py-1 text-xs font-bold rounded-full bg-red-600/90 text-white backdrop-blur-sm border border-white/20">
                  🎬 Video
                </span>
              </div>
            </div>
          )}

          {/* Info Footer */}
          <div class="p-4 border-t border-neutral-100 dark:border-neutral-700">
            <div class="flex items-center justify-between">
              <div>
                <p class="font-bold text-neutral-900 dark:text-white text-sm">{item.name}</p>
                {item.car && (
                  <p class="text-neutral-500 dark:text-neutral-400 text-xs">{item.car}</p>
                )}
              </div>
              <div class="flex text-yellow-400">
                {[1,2,3,4,5].map(() => (
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
            </div>
            {item.quote && (
              <p class="text-neutral-600 dark:text-neutral-400 text-sm mt-2 italic">"{item.quote}"</p>
            )}
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <p class="text-neutral-600 dark:text-neutral-400 mb-4">Ingin berbagi pengalaman Anda?</p>
      <a 
        href="https://wa.me/628158141112?text=Halo, saya ingin berbagi testimoni tentang pembelian mobil di Merdeka Mobil" 
        target="_blank" 
        rel="noopener"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-green-500 hover:bg-green-600 text-white font-bold transition-colors shadow-lg hover:shadow-green-500/25 hover:-translate-y-0.5"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Kirim Testimoni via WhatsApp</span>
      </a>
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div id="lightbox" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md items-center justify-center p-4 transition-opacity duration-300 opacity-0" onclick="closeLightbox()">
    
    <!-- Close Button -->
    <button class="absolute top-4 right-4 text-white/70 hover:text-white transition-colors p-2" onclick="closeLightbox()">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <!-- Content Container -->
    <div class="relative w-full max-w-5xl max-h-[85vh] flex items-center justify-center" onclick="event.stopPropagation()">
      <div id="lightbox-content" class="w-full h-full flex items-center justify-center">
        <!-- Injected via JS -->
      </div>
    </div>
  </div>
</section>

<script is:inline>
  function openLightbox(type, source) {
    const lightbox = document.getElementById('lightbox');
    const content = document.getElementById('lightbox-content');
    
    // Disable scroll
    document.body.style.overflow = 'hidden';
    
    // Clear previous content
    content.innerHTML = '';
    
    if (type === 'video') {
      content.innerHTML = `
        <div class="aspect-video w-full rounded-xl overflow-hidden shadow-2xl bg-black">
          <iframe 
            src="https://www.youtube.com/embed/${source}?autoplay=1" 
            class="w-full h-full" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen>
          </iframe>
        </div>
      `;
    } else {
      content.innerHTML = `
        <img 
          src="${source}" 
          class="max-w-full max-h-[85vh] rounded-xl shadow-2xl object-contain" 
          alt="Full screen view"
        />
      `;
    }
    
    // Show lightbox with Flexbox for centering
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    
    // Small delay for transition
    requestAnimationFrame(() => {
      lightbox.classList.remove('opacity-0');
    });
  }

  function closeLightbox() {
    const lightbox = document.getElementById('lightbox');
    const content = document.getElementById('lightbox-content');
    
    // Enable scroll
    document.body.style.overflow = '';
    
    // Fade out
    lightbox.classList.add('opacity-0');
    
    setTimeout(() => {
      lightbox.classList.remove('flex');
      lightbox.classList.add('hidden');
      content.innerHTML = ''; // Stop video playback
    }, 300);
  }

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });
</script>

<style>
  .testimonial-card {
    animation: fadeInUp 0.5s ease-out forwards;
    opacity: 0;
  }
  
  .testimonial-card:nth-child(1) { animation-delay: 0ms; }
  .testimonial-card:nth-child(2) { animation-delay: 100ms; }
  .testimonial-card:nth-child(3) { animation-delay: 200ms; }
  .testimonial-card:nth-child(4) { animation-delay: 300ms; }
  .testimonial-card:nth-child(5) { animation-delay: 400ms; }
  .testimonial-card:nth-child(6) { animation-delay: 500ms; }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
