---
interface Props {
 message: string;
 icon?: 'search' | 'car' | 'info';
}

const { message, icon = 'search' } = Astro.props;

const icons = {
 search: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>`,
 car: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>`,
 info: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>`,
};
---

<div class="flex flex-col items-center justify-center py-20 px-4 text-center">
 <div class="w-24 h-24 bg-gradient-to-br from-neutral-100 to-neutral-200 dark:from-neutral-800 dark:to-neutral-700 rounded-2xl flex items-center justify-center mb-6 shadow-lg">
 <svg class="w-12 h-12 text-neutral-400 dark:text-neutral-500 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24">
 <Fragment set:html={icons[icon]} />
 </svg>
 </div>
 <h3 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-3">
 {message}
 </h3>
 <p class="text-neutral-500 dark:text-neutral-400 max-w-md font-medium">
 Coba ubah filter atau kata kunci pencarian Anda
 </p>
</div>
