---
import { fetchSettings } from '../utils/fetchData';

interface Props {
  availableCars: number;
  soldCars: number;
}

const { availableCars } = Astro.props;

// Fetch settings for promo
const settings = await fetchSettings();
// Promo tampil by default, kecuali promo_active = FALSE
const isPromoActive = settings.promo_active !== 'FALSE' && settings.promo_active !== 'false' && settings.promo_active !== '0';
const promoEmoji = settings.promo_emoji || '🎄';
const promoText = settings.promo_text || 'Promo Akhir Tahun - DP Mulai 15 Juta!';

// Social Media Links
const socialMedia = {
  youtube: 'https://youtube.com/@merdekamobil',
  instagram: 'https://instagram.com/merdekamobil'
};

// Service highlights
const services = [
  {
    icon: 'swap',
    title: 'Tukar Tambah',
    desc: 'Tukar mobil lama dengan yang baru'
  },
  {
    icon: 'buy',
    title: 'Beli Mobil Anda',
    desc: 'Kami siap beli mobil bekas Anda'
  },
  {
    icon: 'check',
    title: 'Tim Inspeksi',
    desc: 'Cek kualitas unit apa adanya'
  },
  {
    icon: 'credit',
    title: 'Bantuan Kredit',
    desc: 'Kerjasama dengan leasing terpercaya'
  }
];
---

<section class="hero-section relative overflow-hidden min-h-screen flex items-center">
  <!-- Background Elements -->
  <div class="absolute inset-0 bg-gradient-to-br from-primary-900 via-primary-800 to-neutral-900"></div>
  <div class="absolute inset-0 opacity-30">
    <div class="absolute top-20 left-10 w-72 h-72 bg-accent-500 rounded-full blur-[120px] animate-pulse"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-primary-400 rounded-full blur-[150px] animate-pulse" style="animation-delay: 1s;"></div>
  </div>
  
  <!-- Grid Pattern Overlay -->
  <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>

  <div class="container-custom relative z-10 py-16 lg:py-20">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      
      <!-- Left Content -->
      <div class="space-y-6 animate-fade-in">
        <!-- Promo Badge (Dynamic from Spreadsheet) -->
        {isPromoActive && (
          <div class="promo-badge inline-flex items-center gap-2 px-4 py-2 rounded-full bg-gradient-to-r from-accent-600 to-accent-500 text-white text-sm font-semibold shadow-lg">
            <span class="text-lg">{promoEmoji}</span>
            <span>{promoText}</span>
            <span class="promo-shine"></span>
          </div>
        )}

        <!-- Main Heading -->
        <div class="space-y-4">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight">
            Temukan <span class="text-transparent bg-clip-text bg-gradient-to-r from-accent-400 to-accent-500">Mobil Impian</span> Anda
          </h1>
          <p class="text-lg md:text-xl text-white/70 max-w-xl leading-relaxed">
            Dealer mobil bekas terpercaya di Purwokerto. <strong class="text-white/90">10+ tahun pengalaman</strong> melayani pelanggan dengan kualitas terjamin.
          </p>
        </div>

        <!-- Stats Row -->
        <div class="flex flex-wrap gap-6">
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-black text-white">{availableCars}+</div>
            <div class="text-sm text-white/60">Mobil Tersedia</div>
          </div>
          <div class="w-px bg-white/20 hidden sm:block"></div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-black text-white">10+</div>
            <div class="text-sm text-white/60">Tahun Pengalaman</div>
          </div>
          <div class="w-px bg-white/20 hidden sm:block"></div>
          <div class="text-center">
            <div class="text-3xl md:text-4xl font-black text-green-400">✓</div>
            <div class="text-sm text-white/60">Kualitas Terjamin</div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4">
          <a href="/mobil-tersedia" class="btn text-lg px-8 py-4 flex items-center gap-2 group bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-semibold shadow-lg hover:shadow-orange-500/30">
            <span>Lihat Katalog</span>
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
          <a href="https://wa.me/628158141112" target="_blank" rel="noopener" class="btn bg-white/10 backdrop-blur-sm border-2 border-white/30 text-white hover:bg-white hover:text-primary-900 text-lg px-6 py-4 flex items-center gap-2">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            <span>WhatsApp</span>
          </a>
        </div>

        <!-- Social Media Links -->
        <div class="flex items-center gap-4 pt-2">
          <span class="text-white/50 text-sm">Ikuti Kami:</span>
          <a href={socialMedia.youtube} target="_blank" rel="noopener" class="group flex items-center gap-2 text-white/70 hover:text-accent-400 transition-colors">
            <div class="w-9 h-9 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center group-hover:bg-accent-500/20 transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </div>
            <span class="text-sm">YouTube</span>
          </a>
          <a href={socialMedia.instagram} target="_blank" rel="noopener" class="group flex items-center gap-2 text-white/70 hover:text-accent-400 transition-colors">
            <div class="w-9 h-9 rounded-full bg-white/10 backdrop-blur-sm flex items-center justify-center group-hover:bg-accent-500/20 transition-colors">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </div>
            <span class="text-sm">Instagram</span>
          </a>
        </div>
      </div>

      <!-- Right Side - Trust Badges -->
      <div class="hidden lg:flex flex-col items-center justify-center space-y-8 animate-fade-in" style="animation-delay: 0.3s;">
        
        <!-- Main Trust Card -->
        <div class="trust-card p-8 rounded-3xl bg-white/5 backdrop-blur-md border border-white/10 w-full max-w-sm">
          
          <!-- Header -->
          <div class="text-center mb-6">
            <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-accent-500 to-primary-600 mb-4">
              <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <h3 class="text-xl font-bold text-white">Terpercaya & Terjamin</h3>
            <p class="text-white/60 text-sm mt-1">Dealer berizin resmi</p>
          </div>

          <!-- Guarantee Badges -->
          <div class="space-y-3 mb-6">
            <div class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/10">
              <div class="w-10 h-10 rounded-lg bg-green-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <div>
                <p class="text-white font-semibold text-sm">Garansi Mesin</p>
                <p class="text-white/50 text-xs">3 bulan / 5.000 km</p>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/10">
              <div class="w-10 h-10 rounded-lg bg-blue-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
              </div>
              <div>
                <p class="text-white font-semibold text-sm">Dokumen Lengkap</p>
                <p class="text-white/50 text-xs">STNK, BPKB, Faktur</p>
              </div>
            </div>
            <div class="flex items-center gap-3 p-3 rounded-xl bg-white/5 border border-white/10">
              <div class="w-10 h-10 rounded-lg bg-yellow-500/20 flex items-center justify-center">
                <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
              </div>
              <div>
                <p class="text-white font-semibold text-sm">Unit Terinspeksi</p>
                <p class="text-white/50 text-xs">150+ titik pengecekan</p>
              </div>
            </div>
          </div>

          <!-- Leasing Partners -->
          <div class="pt-4 border-t border-white/10">
            <p class="text-white/50 text-xs text-center mb-3">Partner Pembiayaan</p>
            <div class="flex justify-center gap-4">
              <div class="px-3 py-2 rounded-lg bg-white/10 text-white/80 text-xs font-semibold">BCA Finance</div>
              <div class="px-3 py-2 rounded-lg bg-white/10 text-white/80 text-xs font-semibold">Adira</div>
              <div class="px-3 py-2 rounded-lg bg-white/10 text-white/80 text-xs font-semibold">WOM</div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Services Section -->
    <div class="mt-16 lg:mt-20">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        {services.map((service, index) => (
          <div class={`glass-service p-5 md:p-6 rounded-xl transition-all duration-300 hover:scale-105 hover:bg-white/15 animate-fade-in-up stagger-${index + 1}`}>
            <div class="w-12 h-12 rounded-lg bg-green-500/20 flex items-center justify-center mb-4">
              {service.icon === 'swap' && (
                <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/>
                </svg>
              )}
              {service.icon === 'buy' && (
                <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/>
                </svg>
              )}
              {service.icon === 'check' && (
                <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                </svg>
              )}
              {service.icon === 'credit' && (
                <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
                </svg>
              )}
            </div>
            <h3 class="font-bold text-white text-sm md:text-base mb-1">{service.title}</h3>
            <p class="text-white/60 text-xs md:text-sm">{service.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 animate-bounce">
    <a href="#featured" aria-label="Scroll ke bagian mobil pilihan" class="flex flex-col items-center gap-2 text-white/60 hover:text-white transition-colors group">
      <span class="text-xs font-medium tracking-wider uppercase">Scroll</span>
      <svg class="w-6 h-6 group-hover:translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
      </svg>
    </a>
  </div>
</section>

<style>
  .hero-section {
    background: linear-gradient(135deg, #000036 0%, #000063 50%, #1a0f0f 100%);
  }
  
  .glass-service {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .glass-badge {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 8px 16px;
    border-radius: 20px;
  }

  /* Promo Badge with Shine + Pulse Animation */
  .promo-badge {
    position: relative;
    overflow: hidden;
    animation: promoPulse 2s ease-in-out infinite;
  }

  .promo-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.4),
      transparent
    );
    animation: promoShine 3s ease-in-out infinite;
  }

  @keyframes promoPulse {
    0%, 100% { 
      transform: scale(1);
      box-shadow: 0 4px 15px rgba(255, 100, 100, 0.3);
    }
    50% { 
      transform: scale(1.02);
      box-shadow: 0 6px 25px rgba(255, 100, 100, 0.5);
    }
  }

  @keyframes promoShine {
    0% { left: -100%; }
    50%, 100% { left: 100%; }
  }

  /* Search Bar Hero Styling */
  .search-bar-hero select {
    background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%23ffffff' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='M6 8l4 4 4-4'/%3e%3c/svg%3e");
    background-position: right 0.75rem center;
    background-repeat: no-repeat;
    background-size: 1.5em 1.5em;
    padding-right: 2.5rem;
  }

  /* Testimonial Snippet */
  .testimonial-snippet {
    animation: fadeInUp 0.8s ease-out 0.5s both;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Car Container with hover effect */
  .car-container {
    animation: carFloat 4s ease-in-out infinite;
  }

  .car-main {
    filter: drop-shadow(0 20px 40px rgba(255, 0, 0, 0.3));
  }

  @keyframes carFloat {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    25% { transform: translateY(-8px) rotate(0.5deg); }
    75% { transform: translateY(8px) rotate(-0.5deg); }
  }

  /* Spinning Wheel Animation */
  .rim-spokes {
    transform-origin: 145px 220px;
    animation: wheelSpin 1.5s linear infinite;
  }

  .rim-spokes-rear {
    transform-origin: 465px 220px;
    animation: wheelSpin 1.5s linear infinite;
  }

  @keyframes wheelSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  /* Headlight Animations */
  .headlight-beam {
    animation: headlightPulse 1.5s ease-in-out infinite;
  }

  .taillight-beam {
    animation: taillightPulse 0.8s ease-in-out infinite;
  }

  @keyframes headlightPulse {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.1); }
  }

  @keyframes taillightPulse {
    0%, 100% { opacity: 0.8; }
    50% { opacity: 1; }
  }

  /* LED Strip Animation */
  .led-strip {
    animation: ledFlicker 0.5s ease-in-out infinite alternate;
  }

  @keyframes ledFlicker {
    0% { opacity: 0.8; }
    100% { opacity: 1; filter: brightness(1.3); }
  }

  /* Neon Underglow */
  .underglow-main {
    animation: neonPulse 2s ease-in-out infinite;
  }

  .underglow-blur {
    animation: neonPulse 2s ease-in-out infinite;
    opacity: 0.6;
  }

  @keyframes neonPulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  /* Speed Lines */
  .speed-line {
    position: absolute;
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.5), transparent);
    animation: speedLineMove 1.5s linear infinite;
  }

  .speed-line-1 { top: 30%; left: -100px; width: 80px; animation-delay: 0s; }
  .speed-line-2 { top: 45%; left: -120px; width: 100px; animation-delay: 0.3s; }
  .speed-line-3 { top: 55%; left: -80px; width: 60px; animation-delay: 0.6s; }
  .speed-line-4 { top: 65%; left: -100px; width: 70px; animation-delay: 0.9s; }
  .speed-line-5 { top: 75%; left: -90px; width: 50px; animation-delay: 1.2s; }

  @keyframes speedLineMove {
    0% { transform: translateX(0); opacity: 0; }
    20% { opacity: 1; }
    80% { opacity: 1; }
    100% { transform: translateX(600px); opacity: 0; }
  }

  /* Floating Particles */
  .particle {
    position: absolute;
    width: 4px;
    height: 4px;
    background: rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    animation: particleFloat 8s ease-in-out infinite;
  }

  .particle-1 { top: 20%; left: 10%; animation-delay: 0s; }
  .particle-2 { top: 40%; left: 80%; animation-delay: 1s; width: 3px; height: 3px; }
  .particle-3 { top: 60%; left: 20%; animation-delay: 2s; width: 5px; height: 5px; }
  .particle-4 { top: 80%; left: 70%; animation-delay: 3s; }
  .particle-5 { top: 30%; left: 50%; animation-delay: 4s; width: 3px; height: 3px; }
  .particle-6 { top: 70%; left: 40%; animation-delay: 5s; width: 6px; height: 6px; background: rgba(255, 0, 100, 0.6); }
  .particle-7 { top: 15%; left: 60%; animation-delay: 6s; }
  .particle-8 { top: 85%; left: 30%; animation-delay: 7s; width: 4px; height: 4px; }

  @keyframes particleFloat {
    0%, 100% { 
      transform: translate(0, 0) scale(1); 
      opacity: 0;
    }
    10% { opacity: 1; }
    50% { 
      transform: translate(30px, -50px) scale(1.2); 
      opacity: 0.8;
    }
    90% { opacity: 1; }
  }

  /* Rotating Rings */
  .animate-spin-slow {
    animation: spinSlow 20s linear infinite;
  }

  .animate-spin-reverse {
    animation: spinReverse 15s linear infinite;
  }

  @keyframes spinSlow {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(360deg); }
  }

  @keyframes spinReverse {
    from { transform: translate(-50%, -50%) rotate(360deg); }
    to { transform: translate(-50%, -50%) rotate(0deg); }
  }

  /* Pulsing Glow */
  .animate-pulse-glow {
    animation: pulseGlow 3s ease-in-out infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.1); }
  }

  /* Breathe Animation */
  .animate-breathe {
    animation: breathe 4s ease-in-out infinite;
  }

  @keyframes breathe {
    0%, 100% { opacity: 0.3; transform: translate(-50%, -50%) scale(0.95); }
    50% { opacity: 0.5; transform: translate(-50%, -50%) scale(1.05); }
  }

  /* Headlight Cone */
  .headlight-cone {
    background: linear-gradient(90deg, rgba(255, 255, 200, 0.4), transparent);
    clip-path: polygon(0 30%, 100% 0, 100% 100%, 0 70%);
    animation: coneFlicker 2s ease-in-out infinite;
  }

  @keyframes coneFlicker {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 0.5; }
  }

  /* Energy Ring */
  .energy-ring {
    border: 1px solid rgba(255, 0, 100, 0.2);
    border-radius: 50%;
    animation: energyPulse 3s ease-out infinite;
  }

  @keyframes energyPulse {
    0% { 
      opacity: 0.5; 
      transform: translate(-50%, -50%) scale(0.9);
      border-color: rgba(255, 0, 100, 0.3);
    }
    50% { 
      opacity: 0.2; 
      transform: translate(-50%, -50%) scale(1);
      border-color: rgba(255, 0, 100, 0.1);
    }
    100% { 
      opacity: 0.5; 
      transform: translate(-50%, -50%) scale(0.9);
      border-color: rgba(255, 0, 100, 0.3);
    }
  }

  /* Float Animation for badges */
  .animate-float-delayed {
    animation: floatBadge 3s ease-in-out infinite;
  }

  @keyframes floatBadge {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  /* Ground shadow pulse */
  .ground-shadow {
    animation: shadowPulse 2s ease-in-out infinite;
  }

  @keyframes shadowPulse {
    0%, 100% { opacity: 0.3; transform: scaleX(1); }
    50% { opacity: 0.5; transform: scaleX(1.02); }
  }

  /* Body Highlight Shimmer */
  .body-highlight {
    stroke-dasharray: 500;
    stroke-dashoffset: 500;
    animation: shimmer 3s ease-in-out infinite;
  }

  @keyframes shimmer {
    0% { stroke-dashoffset: 500; }
    50% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -500; }
  }
</style>
