---
/**
 * FAQ Section dengan Schema.org FAQPage
 * Membantu SEO dengan rich snippets di Google
 */

const faqs = [
  {
    question: "Apakah mobil bekas di Merdeka Mobil bergaransi?",
    answer: "Ya, semua mobil bekas di Merdeka Mobil mendapat garansi mesin hingga 3 bulan atau 5.000 km (mana yang tercapai lebih dulu). Kami juga melakukan inspeksi 150+ titik sebelum mobil dijual."
  },
  {
    question: "Bagaimana cara beli mobil bekas di Merdeka Mobil?",
    answer: "Caranya mudah: (1) Pilih mobil dari katalog website, (2) Hubungi kami via WhatsApp untuk tanya ketersediaan, (3) Jadwalkan kunjungan untuk test drive, (4) Negosiasi harga, (5) Proses pembayaran cash atau kredit."
  },
  {
    question: "Apakah bisa kredit mobil bekas?",
    answer: "Bisa! Kami bekerja sama dengan leasing terpercaya seperti BCA Finance, Adira, dan WOM. DP mulai dari 15% dengan tenor hingga 5 tahun. Proses cepat, dokumen dibantu."
  },
  {
    question: "Apakah dokumen mobil lengkap dan asli?",
    answer: "Semua mobil di Merdeka Mobil memiliki dokumen lengkap dan asli: STNK, BPKB, Faktur, dan KEUR (jika ada). Kami tidak menjual mobil dengan dokumen bermasalah."
  },
  {
    question: "Bisa tukar tambah mobil lama?",
    answer: "Bisa! Kami menerima tukar tambah dengan mobil lama Anda. Tim kami akan melakukan appraisal untuk menentukan harga terbaik mobil Anda sebagai potongan harga mobil baru."
  },
  {
    question: "Dimana lokasi Merdeka Mobil?",
    answer: "Merdeka Mobil berlokasi di Purwokerto, Kabupaten Banyumas, Jawa Tengah. Kami melayani area Purwokerto, Banyumas, Purbalingga, Cilacap, Banjarnegara, dan sekitarnya."
  }
];

// Generate FAQ Schema
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<section class="py-16 lg:py-24 bg-white dark:bg-neutral-800">
  <div class="container-custom">
    <!-- Section Header -->
    <div class="text-center mb-12 lg:mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-blue-100 dark:bg-blue-900/50 text-blue-800 dark:text-blue-300 text-sm font-semibold mb-4">
        ❓ Pertanyaan Umum
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black text-neutral-900 dark:text-white mb-4">
        FAQ <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-orange-500">Merdeka Mobil</span>
      </h2>
      <p class="text-base sm:text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto px-4 sm:px-0">
        Jawaban untuk pertanyaan yang sering ditanyakan pelanggan kami
      </p>
    </div>

    <!-- FAQ Accordion -->
    <div class="max-w-3xl mx-auto space-y-4">
      {faqs.map((faq, index) => (
        <div class="faq-item bg-neutral-50 dark:bg-neutral-700/50 rounded-2xl border border-neutral-200 dark:border-neutral-600 overflow-hidden" data-animate data-delay={(index % 6) + 1}>
          <button
            class="faq-toggle w-full px-6 py-5 text-left flex items-center justify-between gap-4 hover:bg-neutral-100 dark:hover:bg-neutral-700 transition-colors"
            aria-expanded="false"
            aria-controls={`faq-answer-${index}`}
          >
            <span class="font-bold text-neutral-900 dark:text-white text-sm sm:text-base">{faq.question}</span>
            <svg class="faq-icon w-5 h-5 text-neutral-500 dark:text-neutral-400 flex-shrink-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
            </svg>
          </button>
          <div id={`faq-answer-${index}`} class="faq-content hidden px-6 pb-5">
            <p class="text-neutral-600 dark:text-neutral-300 text-sm sm:text-base leading-relaxed">{faq.answer}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <p class="text-neutral-600 dark:text-neutral-400 mb-4">Masih ada pertanyaan lain?</p>
      <a 
        href="https://wa.me/628158141112?text=Halo, saya ada pertanyaan tentang mobil di Merdeka Mobil" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-green-600 hover:bg-green-700 text-white font-bold transition-colors shadow-lg hover:shadow-green-600/25"
      >
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Tanya via WhatsApp</span>
      </a>
    </div>
  </div>

  <!-- FAQ Schema JSON-LD -->
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</section>

<style>
  .faq-item.active .faq-icon {
    transform: rotate(180deg);
  }
  
  .faq-item.active .faq-content {
    display: block;
  }
</style>

<script is:inline>
  // FAQ Accordion functionality
  document.querySelectorAll('.faq-toggle').forEach(button => {
    button.addEventListener('click', () => {
      const item = button.closest('.faq-item');
      const content = item.querySelector('.faq-content');
      const isActive = item.classList.contains('active');
      
      // Close all other FAQs
      document.querySelectorAll('.faq-item').forEach(otherItem => {
        if (otherItem !== item) {
          otherItem.classList.remove('active');
          otherItem.querySelector('.faq-content').classList.add('hidden');
          otherItem.querySelector('.faq-toggle').setAttribute('aria-expanded', 'false');
        }
      });
      
      // Toggle current FAQ
      if (isActive) {
        item.classList.remove('active');
        content.classList.add('hidden');
        button.setAttribute('aria-expanded', 'false');
      } else {
        item.classList.add('active');
        content.classList.remove('hidden');
        button.setAttribute('aria-expanded', 'true');
      }
    });
  });
</script>
