---
import { SITE_INFO } from '../utils/constants';

interface Props {
 items: { label: string; href: string }[];
}

const { items } = Astro.props;

// Generate BreadcrumbList Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": items.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.label,
    "item": item.href.startsWith('http') ? item.href : `${SITE_INFO.url}${item.href}`
  }))
};
---

<nav aria-label="Breadcrumb" class="mb-8">
 <ol class="flex items-center gap-2.5 text-sm text-neutral-600 dark:text-neutral-400">
 {items.map((item, index) => (
 <li class="flex items-center gap-2.5">
 {index > 0 && (
 <svg class="w-4 h-4 text-neutral-400" fill="currentColor" viewBox="0 0 20 20">
 <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path>
 </svg>
 )}
 {index === items.length - 1 ? (
 <span class="font-bold text-blue-600 dark:text-blue-400">{item.label}</span>
 ) : (
 <a href={item.href} class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium hover:underline">
 {item.label}
 </a>
 )}
 </li>
 ))}
 </ol>
</nav>

<!-- BreadcrumbList Schema JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

