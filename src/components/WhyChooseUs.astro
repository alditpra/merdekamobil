---
// Why Choose Us - Keunggulan Merdeka Mobil
const benefits = [
  {
    icon: 'shield',
    title: 'Garansi Mesin',
    description: 'Garansi 3 bulan / 5.000 km untuk ketenangan pikiran Anda',
    color: 'green'
  },
  {
    icon: 'search',
    title: 'Inspeksi 150+ Titik',
    description: 'Tim mekanik berpengalaman cek kondisi mobil secara menyeluruh',
    color: 'blue'
  },
  {
    icon: 'price',
    title: 'Harga Transparan',
    description: 'Tidak ada biaya tersembunyi, nego jujur & fair. Kepercayaan adalah prioritas kami.',
    color: 'yellow'
  },
  {
    icon: 'credit',
    title: 'Kredit Mudah',
    description: 'Kerjasama dengan leasing terpercaya (BCA Finance, Adira, WOM)',
    color: 'purple'
  },
  {
    icon: 'car',
    title: 'Test Drive Gratis',
    description: 'Coba dulu sebelum memutuskan, tanpa biaya apapun',
    color: 'orange'
  },
  {
    icon: 'support',
    title: 'After Sales Support',
    description: 'Konsultasi perawatan & bantuan teknis setelah pembelian',
    color: 'cyan'
  }
];

const colorClasses: Record<string, string> = {
  green: 'from-green-500 to-emerald-600 shadow-green-500/25',
  blue: 'from-blue-500 to-indigo-600 shadow-blue-500/25',
  yellow: 'from-yellow-500 to-amber-600 shadow-yellow-500/25',
  purple: 'from-purple-500 to-violet-600 shadow-purple-500/25',
  orange: 'from-orange-500 to-red-600 shadow-orange-500/25',
  cyan: 'from-cyan-500 to-teal-600 shadow-cyan-500/25'
};
---

<section class="py-16 lg:py-24 bg-gradient-to-br from-blue-900 via-blue-800 to-neutral-900 relative overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0 opacity-30">
    <div class="absolute top-20 left-10 w-72 h-72 bg-red-500 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-20 right-10 w-96 h-96 bg-blue-400 rounded-full blur-[150px]"></div>
  </div>
  <div class="absolute inset-0 opacity-5" style="background-image: radial-gradient(circle at 1px 1px, white 1px, transparent 0); background-size: 40px 40px;"></div>

  <div class="container-custom relative z-10">
    <!-- Section Header -->
    <div class="text-center mb-12 lg:mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-sm border border-white/20 text-red-400 text-sm font-semibold mb-4">
        ✨ Mengapa Pilih Kami
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-black text-white mb-4">
        Keunggulan <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-orange-500">Merdeka Mobil</span>
      </h2>
      <p class="text-base sm:text-lg text-white/70 max-w-2xl mx-auto px-4 sm:px-0">
        Beli mobil bekas nggak perlu was-was. Semua unit sudah dicek, garansi jelas, harga transparan.
      </p>
    </div>

    <!-- Benefits Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
      {benefits.map((benefit, index) => (
        <div 
          class="benefit-card group p-6 rounded-2xl bg-white/5 backdrop-blur-sm border border-white/10 hover:bg-white/10 transition-all duration-300 hover:-translate-y-1"
          data-animate
          data-delay={(index % 6) + 1}
        >
          <!-- Icon -->
          <div class={`w-14 h-14 rounded-xl bg-gradient-to-br ${colorClasses[benefit.color]} flex items-center justify-center mb-4 shadow-lg group-hover:scale-110 transition-transform`}>
            {benefit.icon === 'shield' && (
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            )}
            {benefit.icon === 'search' && (
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            )}
            {benefit.icon === 'price' && (
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            )}
            {benefit.icon === 'credit' && (
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
              </svg>
            )}
            {benefit.icon === 'car' && (
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h8m-8 5h8m-4-9a9 9 0 110 18 9 9 0 010-18z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17l3-3 3 3m-3-3v6"/>
              </svg>
            )}
            {benefit.icon === 'support' && (
              <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
              </svg>
            )}
          </div>
          
          <!-- Content -->
          <h3 class="text-xl font-bold text-white mb-2">{benefit.title}</h3>
          <p class="text-white/80 text-sm leading-relaxed">{benefit.description}</p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12 lg:mt-16">
      <a href="https://wa.me/628158141112?text=Halo, saya ingin bertanya tentang mobil di Merdeka Mobil" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 px-8 py-4 rounded-xl bg-white text-blue-900 font-bold text-lg hover:bg-neutral-100 transition-all shadow-lg hover:shadow-xl hover:-translate-y-0.5">
        <svg class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 24 24">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        <span>Hubungi Kami Sekarang</span>
      </a>
    </div>
  </div>
</section>


