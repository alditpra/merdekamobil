---
// Navigation Component
// Transparent on home (blends with Hero), solid on other pages
import { SITE_INFO } from '../utils/constants';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;

const navLinks = [
  { href: '/', label: 'Beranda' },
  { href: '/mobil-tersedia', label: 'Mobil Tersedia' },
  { href: '/mobil-terjual', label: 'Terjual' },
  { href: '/kontak', label: 'Kontak' },
];

const currentPath = Astro.url.pathname;
---

<header 
  class:list={[
    'fixed top-0 left-0 right-0 z-50 transition-all duration-300',
    isHome ? 'nav-transparent' : 'nav-solid'
  ]}
  id="main-nav"
>
  <div class="container-custom">
    <nav class="flex items-center justify-between h-16 md:h-20">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <img 
          src="/logo.webp" 
          alt="Merdeka Mobil Logo"
          class="w-10 h-10 md:w-12 md:h-12 object-contain"
          width="48"
          height="48"
          fetchpriority="high"
          decoding="async"
        />
        <div class="hidden sm:block">
          <span class="font-bold text-lg md:text-xl nav-text">{SITE_INFO.name}</span>
          <p class="text-xs nav-subtext -mt-0.5">Mobil Bekas Purwokerto</p>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-1">
        {navLinks.map(link => (
          <a 
            href={link.href}
            class:list={[
              'px-4 py-2 rounded-lg font-medium transition-all duration-200',
              currentPath === link.href 
                ? 'nav-link-active' 
                : 'nav-link'
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Right Side Actions -->
      <div class="flex items-center gap-3">
        <!-- Dark Mode Toggle (hidden on home page) -->
        {!isHome && (
        <button 
          id="theme-toggle" 
          class="nav-icon-btn"
          aria-label="Toggle dark mode"
        >
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
          </svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
          </svg>
        </button>
        )}

        <!-- Mobile Menu Button -->
        <button 
          id="mobile-menu-btn" 
          class="md:hidden nav-icon-btn"
          aria-label="Open menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>
    </nav>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="md:hidden hidden bg-white dark:bg-neutral-900 border-t border-neutral-200 dark:border-neutral-800 shadow-xl">
    <div class="container-custom py-4 space-y-2">
      {navLinks.map(link => (
        <a 
          href={link.href}
          class:list={[
            'block px-4 py-3 rounded-xl font-medium transition-colors',
            currentPath === link.href 
              ? 'bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400' 
              : 'text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800'
          ]}
        >
          {link.label}
        </a>
      ))}
    </div>
  </div>
</header>

<!-- Spacer for fixed nav (only on non-home pages) -->
{!isHome && <div class="h-16 md:h-20"></div>}

<style>
  /* Transparent Navigation (Home - blends with Hero) */
  .nav-transparent {
    background: transparent;
  }

  .nav-transparent .nav-text {
    @apply text-white;
  }

  .nav-transparent .nav-subtext {
    @apply text-white/60;
  }

  .nav-transparent .nav-link {
    @apply text-white/80 hover:text-white hover:bg-white/10;
  }

  .nav-transparent .nav-link-active {
    @apply text-white bg-white/20 backdrop-blur-sm;
  }

  .nav-transparent .nav-icon-btn {
    @apply w-10 h-10 rounded-xl flex items-center justify-center text-white/80 hover:text-white hover:bg-white/10 transition-colors;
  }

  /* Solid Navigation (Scrolled or other pages) */
  .nav-solid {
    @apply bg-white/90 dark:bg-neutral-900/90 backdrop-blur-md shadow-lg border-b border-neutral-200/50 dark:border-neutral-800/50;
  }

  .nav-solid .nav-text {
    @apply text-neutral-900 dark:text-white;
  }

  .nav-solid .nav-subtext {
    @apply text-neutral-500 dark:text-neutral-400;
  }

  .nav-solid .nav-link {
    @apply text-neutral-600 dark:text-neutral-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20;
  }

  .nav-solid .nav-link-active {
    @apply text-blue-600 dark:text-blue-400 bg-blue-100 dark:bg-blue-900/30;
  }

  .nav-solid .nav-icon-btn {
    @apply w-10 h-10 rounded-xl flex items-center justify-center text-neutral-600 dark:text-neutral-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors;
  }

  /* Scrolled state for home page */
  .nav-scrolled {
    @apply bg-white/90 dark:bg-neutral-900/90 backdrop-blur-md shadow-lg border-b border-neutral-200/50 dark:border-neutral-800/50;
  }

  .nav-scrolled .nav-text {
    @apply text-neutral-900 dark:text-white;
  }

  .nav-scrolled .nav-subtext {
    @apply text-neutral-500 dark:text-neutral-400;
  }

  .nav-scrolled .nav-link {
    @apply text-neutral-600 dark:text-neutral-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-blue-50 dark:hover:bg-blue-900/20;
  }

  .nav-scrolled .nav-link-active {
    @apply text-blue-600 dark:text-blue-400 bg-blue-100 dark:bg-blue-900/30;
  }

  .nav-scrolled .nav-icon-btn {
    @apply w-10 h-10 rounded-xl flex items-center justify-center text-neutral-600 dark:text-neutral-300 hover:text-blue-600 dark:hover:text-blue-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors;
  }
</style>

<script is:inline>
  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Dark mode toggle
  const themeToggle = document.getElementById('theme-toggle');
  
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.contains('dark');
    if (isDark) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    }
  });

  // Scroll effect for transparent nav (home page only)
  const nav = document.getElementById('main-nav');
  const isTransparent = nav?.classList.contains('nav-transparent');

  if (isTransparent) {
    const handleScroll = () => {
      if (window.scrollY > 50) {
        nav?.classList.add('nav-scrolled');
        nav?.classList.remove('nav-transparent');
      } else {
        nav?.classList.remove('nav-scrolled');
        nav?.classList.add('nav-transparent');
      }
    };

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll(); // Check initial state
  }
</script>
