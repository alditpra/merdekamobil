---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CarCard from '../components/CarCard.astro';
import EmptyState from '../components/EmptyState.astro';
import { getAvailableCars } from '../utils/fetchData';

const cars = await getAvailableCars();

export async function getStaticPaths() {
 return [{ params: {} }];
}
---

<Layout 
 title="Mobil Bekas Tersedia di Purwokerto - Harga Terbaik & Bergaransi" 
 description="Cari mobil bekas berkualitas di Purwokerto? Lihat koleksi lengkap di Merdeka Mobil. Garansi mesin, dokumen lengkap, harga nego. Toyota, Honda, Daihatsu & lainnya."
>
 <Navigation />
 
 <main class="min-h-screen py-12">
 <div class="container-custom">
 <Breadcrumbs items={[
 { label: 'Beranda', href: '/' },
 { label: 'Mobil Tersedia', href: '/mobil-tersedia' }
 ]} />
 
 <div class="mb-12">
 <h1 class="text-4xl md:text-5xl font-black mb-4 text-shadow">Mobil Bekas Tersedia di Purwokerto</h1>
 <p class="text-lg text-neutral-600 dark:text-neutral-400 font-medium">
 {cars.length} unit mobil bekas berkualitas siap jadi milik Anda. Semua sudah dicek & bergaransi mesin.
 </p>
 </div>
 
 <!-- Cars Grid -->
 {cars.length > 0 ? (
 <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
 {cars.map((car, index) => (
 <div data-animate data-delay={(index % 6) + 1}>
 <CarCard car={car} />
 </div>
 ))}
 </div>
 ) : (
 <EmptyState 
 message="Belum ada mobil tersedia" 
 icon="car"
 />
 )}
 </div>
 </main>
 
 <Footer />
</Layout>
