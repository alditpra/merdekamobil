---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { WHATSAPP_NUMBER } from '../utils/constants';
import { generateWhatsAppURL } from '../utils/formatters';

const waUrl = generateWhatsAppURL(WHATSAPP_NUMBER);
---

<Layout
 title="Kontak Kami"
 description="Hubungi Merdeka Mobil Purwokerto untuk informasi lebih lanjut tentang mobil bekas berkualitas. Kami siap membantu Anda."
>
 
 <main class="min-h-screen py-12">
 <div class="container-custom">
 <Breadcrumbs items={[
 { label: 'Home', href: '/' },
 { label: 'Kontak', href: '/kontak' }
 ]} />
 
 <div class="mb-12 text-center">
 <h1 class="text-4xl md:text-5xl font-black mb-4 text-shadow">Hubungi Kami</h1>
 <p class="text-lg text-neutral-600 dark:text-neutral-400 font-medium max-w-2xl mx-auto">
 Ada pertanyaan? Kami siap membantu Anda menemukan mobil impian
 </p>
 </div>
 
 <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 max-w-6xl mx-auto">
 <!-- Contact Form -->
 <div class="glass-card p-8 md:p-10">
 <h2 class="font-extrabold text-2xl mb-8">Kirim Pesan</h2>
 <form id="contact-form" class="space-y-6">
 <div>
 <label for="name" class="block text-sm font-bold mb-2">Nama Lengkap</label>
 <input
 type="text"
 id="name"
 name="name"
 required
 class="input"
 placeholder="John Doe"
 />
 </div>
 
 <div>
 <label for="phone" class="block text-sm font-bold mb-2">Nomor HP</label>
 <input
 type="tel"
 id="phone"
 name="phone"
 required
 class="input"
 placeholder="081234567890"
 />
 </div>
 
 <div>
 <label for="message" class="block text-sm font-bold mb-2">Pesan</label>
 <textarea
 id="message"
 name="message"
 rows="5"
 required
 class="input resize-none"
 placeholder="Saya ingin bertanya tentang..."
 ></textarea>
 </div>
 
 <button type="submit" class="btn-accent w-full text-lg">
 <span class="flex items-center justify-center gap-2">
 <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
 <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
 </svg>
 Kirim via WhatsApp
 </span>
 </button>
 </form>
 </div>
 
 <!-- Contact Info -->
 <div class="space-y-6">
 <div class="glass-card p-8 group hover:scale-[1.02] transition-transform duration-300">
 <div class="flex items-start gap-5">
 <div class="w-14 h-14 bg-gradient-to-br from-primary-100 to-primary-200 dark:from-primary-900 dark:to-primary-800 rounded-2xl flex items-center justify-center flex-shrink-0 transition-shadow">
 <svg class="w-7 h-7 text-primary-600 dark:text-primary-400" fill="currentColor" viewBox="0 0 20 20">
 <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
 </svg>
 </div>
 <div>
 <h3 class="font-extrabold text-lg mb-2">Telepon / WhatsApp</h3>
 <a href={waUrl} target="_blank" rel="noopener noreferrer" class="text-primary-600 dark:text-primary-400 hover:underline font-semibold text-lg">
 0815-8141-112
 </a>
 </div>
 </div>
 </div>
 
 <div class="glass-card p-8 group hover:scale-[1.02] transition-transform duration-300">
 <div class="flex items-start gap-5">
 <div class="w-14 h-14 bg-gradient-to-br from-accent-100 to-accent-200 dark:from-accent-900 dark:to-accent-800 rounded-2xl flex items-center justify-center flex-shrink-0 transition-shadow">
 <svg class="w-7 h-7 text-accent-600 dark:text-accent-400" fill="currentColor" viewBox="0 0 20 20">
 <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
 </svg>
 </div>
 <div>
 <h3 class="font-extrabold text-lg mb-2">Lokasi</h3>
 <p class="text-neutral-600 dark:text-neutral-400 font-medium leading-relaxed">
 Purwokerto<br/>
 Jawa Tengah, Indonesia
 </p>
 </div>
 </div>
 </div>
 
 <div class="glass-card p-8 group hover:scale-[1.02] transition-transform duration-300">
 <div class="flex items-start gap-5">
 <div class="w-14 h-14 bg-gradient-to-br from-secondary-100 to-secondary-200 dark:from-secondary-900 dark:to-secondary-800 rounded-2xl flex items-center justify-center flex-shrink-0 transition-shadow">
 <svg class="w-7 h-7 text-secondary-600 dark:text-secondary-400" fill="currentColor" viewBox="0 0 20 20">
 <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
 </svg>
 </div>
 <div>
 <h3 class="font-extrabold text-lg mb-2">Jam Operasional</h3>
 <p class="text-neutral-600 dark:text-neutral-400 font-medium leading-relaxed">
 Senin - Sabtu: 08:00 - 17:00<br/>
 Minggu: Tutup
 </p>
 </div>
 </div>
 </div>
 </div>
 </div>
 </div>
 </main>
 
 <Footer />
 <WhatsAppButton />
</Layout>

<script define:vars={{ waUrl }}>
 const form = document.getElementById('contact-form');
 form?.addEventListener('submit', (e) => {
 e.preventDefault();
 
 const formData = new FormData(e.target);
 const name = formData.get('name');
 const phone = formData.get('phone');
 const message = formData.get('message');
 
 const whatsappMessage = `Halo Merdeka Mobil,\n\nNama: ${name}\nHP: ${phone}\n\nPesan:\n${message}`;
 const url = `${waUrl.split('?')[0]}?text=${encodeURIComponent(whatsappMessage)}`;
 
 window.open(url, '_blank');
 });
</script>
