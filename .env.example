# Environment Variables for Merdeka Mobil

# Google Sheets CSV URLs
# To get these URLs:
# 1. Open your Google Sheet
# 2. File > Share > Publish to web
# 3. Select the sheet (e.g., "Cars" or "Settings")
# 4. Choose "Comma-separated values (.csv)"
# 5. Click "Publish" and copy the URL

# Cars sheet CSV URL
PUBLIC_CARS_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv&gid=0

# Settings sheet CSV URL
PUBLIC_SETTINGS_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv&gid=123

# Note: Replace YOUR_SHEET_ID with your actual Google Sheets ID
# The gid parameter is the sheet's unique ID (you can find it in the URL when viewing that sheet)
